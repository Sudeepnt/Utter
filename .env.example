# Public GitHub repository containing the published, verified installers.
# Defaults to Sudeepnt/Utter for both platforms.
UTTER_MAC_RELEASE_REPO=Sudeepnt/Utter
UTTER_WINDOWS_RELEASE_REPO=Sudeepnt/Utter
# Optional server-only GitHub API token (for rate limits). Never NEXT_PUBLIC_.
# Installer asset URLs must remain publicly accessible without authentication.
GITHUB_RELEASE_TOKEN=

# Optional canonical website URL. Vercel production hostname is detected automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
